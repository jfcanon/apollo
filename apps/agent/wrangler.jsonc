{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "apollo",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "ai": {
    "binding": "AI",
  },
  "vars": {
    "VOICE_PROVIDER": "workersai",
    "LLM_BASE_URL": "https://api.deepseek.com",
    "LLM_MODEL": "deepseek-chat",
    "STT_LANGUAGE": "en",
    "AURA_SPEAKER": "draco",
    "BRAIN_URL": "https://brain.ygdcbtmc4u.uk",
    "WORKERSAI_TTS_MODEL": "@cf/deepgram/aura-2-en",
    "OPENROUTER_MODEL": "deepseek/deepseek-v4-flash-0731",
    "OPENROUTER_STT_MODEL": "openai/whisper-large-v3",
    "OPENROUTER_RESEARCH_MODEL": "perplexity/sonar-deep-research",
    "OPENROUTER_CODING_MODEL": "moonshotai/kimi-k3",
    "ELEVENLABS_TTS_MODEL": "eleven_multilingual_v2",
    "OPENROUTER_EMBEDDING_MODEL": "openai/text-embedding-3-small",
    "APOLLO_OWNER_EMAIL": "nahuelavalos@gmail.com",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "Apollo",
        "class_name": "Apollo",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Apollo"],
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "apollo-media",
      "preview_bucket_name": "apollo-media-preview",
    },
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "apollo-memory",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "APOLLO_QUEUE",
        "queue": "apollo-jobs",
      },
    ],
    "consumers": [
      {
        "queue": "apollo-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
      },
    ],
  },
  "workflows": [
    {
      "name": "apollo-background",
      "binding": "BACKGROUND",
      "class_name": "ApolloBackground",
    },
    {
      "name": "apollo-coding",
      "binding": "CODING",
      "class_name": "ApolloCoding",
    },
  ],
}
