{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "apollo",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "ai": {
    "binding": "AI",
  },
  "vars": {
    // "groq" = Groq STT (whisper-large-v3-turbo) + Groq TTS (playai-tts / orpheus)
    // + the LLM configured below. Spends ZERO Workers AI neurons. Free tier, no hard quota.
    // "free" used Gemini TTS which hit 429 quota — switched to groq for production.
    "VOICE_PROVIDER": "local",
    "LLM_BASE_URL": "https://api.deepseek.com",
    "LLM_MODEL": "deepseek-chat",
    "STT_LANGUAGE": "en",
    // Tunnel URL for the local Whisper STT server (NID-515). Only used when
    // VOICE_PROVIDER selects the local provider.
    "LOCAL_STT_URL": "https://stt.ygdcbtmc4u.uk",
    // Local Qwen LLM via tunnel (NID-470). LOCAL_LLM_MODEL must be the mlx repo id.
    "LOCAL_LLM_URL": "https://llm.ygdcbtmc4u.uk/v1",
    "LOCAL_LLM_MODEL": "mlx-community/Qwen3.8-27B-4bit",
    "AURA_SPEAKER": "draco",
    "BRAIN_URL": "https://brain.ygdcbtmc4u.uk",
    "WORKERSAI_TTS_MODEL": "@cf/deepgram/aura-2-en",
    "ELEVENLABS_TTS_MODEL": "eleven_multilingual_v2",
    "APOLLO_OWNER_EMAIL": "nahuelavalos@gmail.com",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "Apollo",
        "class_name": "Apollo",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Apollo"],
    },
  ],
  "kv_namespaces": [
    {
      // Hue Remote API OAuth tokens + application key. Rotating values only;
      // the client id/secret are Worker secrets (HUE_CLIENT_ID/HUE_CLIENT_SECRET).
      "binding": "HUE_TOKENS",
      "id": "81aeb6dd222441e191c4382b756245b2",
    },
    {
      // Google OAuth tokens for the calendar tools, plus the short-lived state
      // nonces the one-shot link flow issues. Rotating values only; the client
      // id/secret are Worker secrets (GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET).
      "binding": "GOOGLE_TOKENS",
      "id": "4029e26a38a14745b63907d94a1770a1",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "apollo-media",
      "preview_bucket_name": "apollo-media-preview",
    },
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "apollo-memory",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "APOLLO_QUEUE",
        "queue": "apollo-jobs",
      },
    ],
    "consumers": [
      {
        "queue": "apollo-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
      },
    ],
  },
  "workflows": [
    {
      "name": "apollo-background",
      "binding": "BACKGROUND",
      "class_name": "ApolloBackground",
    },
    {
      "name": "apollo-coding",
      "binding": "CODING",
      "class_name": "ApolloCoding",
    },
  ],
}
